# =============================================================================
# Dharohar Configurable Product - Frontend Environment Template
# Copy this file to frontend/.env and customize as needed.
# =============================================================================

# Backend API base URL
# Local development: http://localhost:8000
# Production: https://api.yourdomain.com
VITE_API_URL=http://localhost:8000

# Application display title
VITE_APP_TITLE=Dharohar

# Match backend DEMO_MODE setting: "true" for offline prototype simulation; "false" for product mode
VITE_DEMO_MODE=false

# Firebase Web App Client Configuration
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
