# =============================================================================
# Dharohar Configurable Product - Backend Environment Template
# Copy this file to backend/.env and populate with your configuration.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime Environment & Product Mode
# -----------------------------------------------------------------------------
# Active environment: "development" | "production" | "test"
# In "production", startup fails if any required production variables are missing.
ENV=development

# Product demo mode: "true" | "false" (default is false)
# When false: Demo-only routes (/seed, /demo/*) return 404,
# scripted LLM is disabled, and real OTP flow is enforced.
# When true: Unlocks /seed, /demo/*, simulated OTP.
DEMO_MODE=false

# Payment provider selection: "mock" | "razorpay" (default is "mock")
# - "mock": Uses in-memory MockProvider with test simulated escrow (no real money).
#           The frontend will NOT load the Razorpay Checkout script or open Checkout.
#           The Pay button shows "Pay (simulated)" with a visible disclaimer label.
#           The webhook endpoint /webhooks/razorpay returns 404.
# - "razorpay": Uses real Razorpay gateway. Requires RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET;
#               otherwise startup fails immediately.
# - In production (ENV=production), PAYMENT_PROVIDER cannot be "mock" (must be "razorpay").
PAYMENT_PROVIDER=mock

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite or PostgreSQL database connection URL.
# SQLite default: sqlite:///backend/dharohar.db
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/dharohar
DATABASE_URL=

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# 48-byte URL-safe secret for signing JWT access tokens (required in production).
AUTH_SECRET=

# Fernet symmetric encryption key for encrypting sensitive fields at rest.
# BACK UP THIS KEY: if lost, existing encrypted fields cannot be decrypted.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# LLM & AI Provider Configuration
# -----------------------------------------------------------------------------
# Default LLM provider is real: "gemini" | "anthropic"
# "scripted" is available ONLY when DEMO_MODE=true or during automated tests.
LLM_PROVIDER=gemini

# Primary API key for the LLM provider selected above (required in production).
LLM_API_KEY=

# Target LLM model ID (e.g. "gemini-2.5-flash", "claude-3-5-sonnet-20241022").
LLM_MODEL=

# -----------------------------------------------------------------------------
# Firebase & Google Cloud
# -----------------------------------------------------------------------------
# Path to Firebase service account JSON credentials file.
FIREBASE_CREDENTIALS_PATH=

# -----------------------------------------------------------------------------
# File Storage Configuration
# -----------------------------------------------------------------------------
# Cloud Storage bucket name (GCS / S3) or local upload directory.
STORAGE_BUCKET_NAME=
UPLOAD_DIR=backend/uploads

# -----------------------------------------------------------------------------
# Razorpay Payment Gateway (Escrow & Artist Payouts)
# -----------------------------------------------------------------------------
# Razorpay Key ID (rzp_test_... or rzp_live_...) (required in production).
RAZORPAY_KEY_ID=

# Razorpay Key Secret (required in production).
RAZORPAY_KEY_SECRET=

# Secret configured in Razorpay Dashboard for webhook signature verification.
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Platform Fees & Escrow Rules
# -----------------------------------------------------------------------------
# Platform fee percentage charged to organizer (default 5.0%).
PLATFORM_FEE_PERCENT=5.0

# GST percentage applied to the platform fee (default 18.0%).
FEE_GST_PERCENT=18.0

# Post-event dispute window in hours before payout release is eligible (default 48).
DISPUTE_WINDOW_HOURS=48

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# -----------------------------------------------------------------------------
# System User Access Token from Meta Developer Portal (required in production).
WHATSAPP_TOKEN=

# WhatsApp Business Phone Number ID from WhatsApp App Dashboard (required in production).
WHATSAPP_PHONE_ID=

# Custom Webhook Verification Token used during Meta Webhook verification handshake.
WHATSAPP_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# CORS & Webhook Endpoints
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS.
# Example: http://localhost:5173,http://localhost:3000,https://dharohar.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Public HTTPS URL for incoming Razorpay and WhatsApp webhooks (e.g., ngrok tunnel or domain).
PUBLIC_BASE_URL=
